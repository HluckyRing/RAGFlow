# DeepSeek API 配置（必填）
API_KEY="sk-你的密钥"
BASE_URL="https://api.deepseek.com"
MODEL_NAME="deepseek-flash"

# 向量模型（可选，默认 BAAI/bge-small-zh-v1.5）
# EMBEDDING_MODEL="BAAI/bge-small-zh-v1.5"

# 检索参数（可选）
# TOP_K=10
# CHUNK_SIZE=600
# CHUNK_OVERLAP=100
# MAX_CONTEXT_LENGTH=8000
# 向量相关性阈值（l2 距离，越小越严格）；换语料/换 embedding 模型需重新标定
# MAX_DISTANCE=0.55

# 单次上传大小上限（MB，默认 20）
# MAX_UPLOAD_MB=20
# 调用大模型超时（秒，默认 60）
# LLM_TIMEOUT=60

# 存储路径（可选）——相对路径一律锚定项目根，换目录启动不会漂
# VECTOR_DB_PATH="./chroma_db"
# STATE_DIR="./state"

# 服务监听（可选）——默认只绑回环；这个服务没有鉴权，要对外提供才改成 0.0.0.0
# HOST="127.0.0.1"
# PORT=8080

# HuggingFace 镜像（国内用户建议保留）
HF_ENDPOINT="https://hf-mirror.com"
