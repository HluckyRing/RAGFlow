# DeepSeek API 配置（必填）
API_KEY="sk-你的密钥"
BASE_URL="https://api.deepseek.com"
MODEL_NAME="deepseek-flash"

# 向量模型（可选，默认 BAAI/bge-small-zh-v1.5）
# EMBEDDING_MODEL="BAAI/bge-small-zh-v1.5"

# 检索参数（可选）
# TOP_K=10
# 切片长度（字）：受 embedding 模型 512 token 窗口约束，默认 480
# CHUNK_SIZE=480
# CHUNK_OVERLAP=100
# MAX_CONTEXT_LENGTH=8000
# 向量相关性阈值（l2 距离，越小越严格）；换语料/换 embedding 模型需重新标定
# MAX_DISTANCE=0.55

# 双路融合（可选）—— 把「原问题」和「HyDE 文本」各当一次向量探针，两路名次用 RRF 合并。
# 效果（2026-11-05 实测，合成语料 59 条：36 正 + 15 远域负 + 8 域内负）：
#   recall@5 与文件/section 归属一分不掉，MRR 0.972 → 1.000；
#   远域负样本误召回 11/15 → 2/15（与 no-hyde 同水平），域内「看着像但没答案」的 8/8 挡不住。
# 代价：每问多一次 embedding 查询，实测 +17 ms（本地 CPU）。
# 副作用：闸门收窄后更多提问会落进关键词兜底（4/59 → 15/59）。
# 想让召回优先就用 FUSION_GATE=union；完全回到改造前就设 FUSION_ENABLED=0。
# FUSION_ENABLED=1
# FUSION_GATE="intersect"
# RRF_K=60

# 可答性判断（可选，**默认关**）—— 严格模式下，检索到材料后再让模型判一次「这段材料能不能
# 回答这个问题」，判「不能」直接回「未找到相关内容」（400，不生成回答、提问不入历史）。
# 为什么默认关（2026-11-06 实测 59 条）：它每条提问固定 +0.78 s，而**生成那次调用自己就会拒答**
# （QA prompt 第 1 条要求「背景没有答案就说背景中没有提到相关内容」）——域内负样本 8/8、远域 2/2
# 正确拒答，正样本 0/36 误拒，与独立判定分毫不差，却零额外调用（生成中位 1.30 s）。
# 需要「不许为不可答问题产生任何回答」时才设 1；也用 scripts/measure_inline_abstention.py 复测。
# ANSWERABILITY_CHECK=0
# ANSWERABILITY_MAX_TOKENS=32

# 拆问（query 分解）：复合问句先拆成子问题、每问分路检索，再按名额合并 context。
# 默认开（2026-11-08 第九轮：四道门实测全过——复合问答全 87.5%→100%、域外复合问 4/4 拒答、
# 首字延迟中位 −0.55 s、零错误）。关掉就回到「整句一次检索」，连闸门都不跑、不花 API。
# DECOMPOSE_ENABLED=1
# DECOMPOSE_MAX_PARTS=6

# 跨文件取样：枚举 / 汇总型提问（「列出所有的实验」「主要内容是什么」）保证每份文件都有代表块。
# 默认关（2026-11-12 第十二轮）：真实日志里 13 份文件的语料装配后只覆盖 12 份，缺的那份是
# 检索按相关度 + 距离闸门筛掉的，而且没有任何提示。开了之后那两条真实提问 12/13 → 13/13，
# 其余 10 条逐位不变，块预算不变，代价是每缺一份文件多一次限定在该文件内的补位查询
# （13 文件 / 1061 块语料实测 +14 ms）。关着时连闸门都不跑。
# COVERAGE_SAMPLING=0
# COVERAGE_BACKFILL_MAX=8
# 同一份文件内部跨节取样（问句点名章号时按页均匀铺开，块数按字符预算反推）
# COVERAGE_INTRA_FILE_BLOCKS=30
# COVERAGE_INTRA_FILE_CANDIDATES=40

# 跨编码器精排（reranker，可选）
# 效果：线上口径（HyDE）下把「无关问题被强行作答」从 2/5 压到 0/5，recall/MRR/归属一分不掉。
# 代价：CPU 实测 3.9 s/次（20 候选），所以默认关闭；想开就设 1。
# 权重（BAAI/bge-reranker-base，MIT，1.11GB）下载慢的话，可先用 ModelScope 拉到本地目录，
# 再把 RERANK_MODEL 指向那个目录（实测 12.6 MB/s，约 90 秒）。
# RERANK_ENABLED=0
# RERANK_MODEL="BAAI/bge-reranker-base"
# RERANK_CANDIDATES=20
# RERANK_TOP_N=5
# RERANK_MIN_SCORE=0.3

# 单次上传大小上限（MB，默认 20）
# MAX_UPLOAD_MB=20
# 调用大模型超时（秒，默认 60）
# LLM_TIMEOUT=60

# 存储路径（可选）——相对路径一律锚定项目根，换目录启动不会漂
# VECTOR_DB_PATH="./chroma_db"
# STATE_DIR="./state"

# 服务监听（可选）——默认只绑回环；这个服务没有鉴权，要对外提供才改成 0.0.0.0
# HOST="127.0.0.1"
# PORT=8080

# 鉴权令牌：**对外监听时必须设置**，否则服务拒绝启动（src/security.py 的启动自检）。
# 本机回环使用可以留空 —— 与改造前一样零摩擦。
# 这个服务没有内建账号体系：设了 token 也只是「知道口令就能读写全部对话」。
# AUTH_TOKEN=""
# /api/chat 限流：每问一次都要花钱调大模型，被刷就是真金白银。
# 按客户端 IP 的滑动窗口计数；0 = 关闭。
# CHAT_RATE_LIMIT=20
# CHAT_RATE_WINDOW=60

# HuggingFace 镜像（国内用户建议保留）
HF_ENDPOINT="https://hf-mirror.com"
