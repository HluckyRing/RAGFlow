# DeepSeek API 配置（必填）
API_KEY="sk-你的密钥"
BASE_URL="https://api.deepseek.com"
MODEL_NAME="deepseek-flash"

# 向量模型（可选，默认 BAAI/bge-small-zh-v1.5）
# EMBEDDING_MODEL="BAAI/bge-small-zh-v1.5"

# 检索参数（可选）
# TOP_K=10
# 切片长度（字）：受 embedding 模型 512 token 窗口约束，默认 480
# CHUNK_SIZE=480
# CHUNK_OVERLAP=100
# MAX_CONTEXT_LENGTH=8000
# 向量相关性阈值（l2 距离，越小越严格）；换语料/换 embedding 模型需重新标定
# MAX_DISTANCE=0.55

# 跨编码器精排（reranker，可选）
# 效果：线上口径（HyDE）下把「无关问题被强行作答」从 2/5 压到 0/5，recall/MRR/归属一分不掉。
# 代价：CPU 实测 3.9 s/次（20 候选），所以默认关闭；想开就设 1。
# 权重（BAAI/bge-reranker-base，MIT，1.11GB）下载慢的话，可先用 ModelScope 拉到本地目录，
# 再把 RERANK_MODEL 指向那个目录（实测 12.6 MB/s，约 90 秒）。
# RERANK_ENABLED=0
# RERANK_MODEL="BAAI/bge-reranker-base"
# RERANK_CANDIDATES=20
# RERANK_TOP_N=5
# RERANK_MIN_SCORE=0.3

# 单次上传大小上限（MB，默认 20）
# MAX_UPLOAD_MB=20
# 调用大模型超时（秒，默认 60）
# LLM_TIMEOUT=60

# 存储路径（可选）——相对路径一律锚定项目根，换目录启动不会漂
# VECTOR_DB_PATH="./chroma_db"
# STATE_DIR="./state"

# 服务监听（可选）——默认只绑回环；这个服务没有鉴权，要对外提供才改成 0.0.0.0
# HOST="127.0.0.1"
# PORT=8080

# HuggingFace 镜像（国内用户建议保留）
HF_ENDPOINT="https://hf-mirror.com"
